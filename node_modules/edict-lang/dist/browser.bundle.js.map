        },
        {
          "$ref": "#/definitions/FieldAccess"
        },
        {
          "$ref": "#/definitions/LambdaExpr"
        },
        {
          "$ref": "#/definitions/BlockExpr"
        },
        {
          "$ref": "#/definitions/StringInterp"
        },
        {
          "$ref": "#/definitions/ForallExpr"
        },
        {
          "$ref": "#/definitions/ExistsExpr"
        },
        {
          "$ref": "#/definitions/ToolCallExpr"
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "literal",
            "ident",
            "binop",
            "unop",
            "call",
            "if",
            "let",
            "match",
            "array",
            "tuple_expr",
            "record_expr",
            "enum_constructor",
            "access",
            "lambda",
            "block",
            "string_interp",
            "forall",
            "exists",
            "tool_call"
          ]
        }
      }
    },
    "Literal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "literal"
