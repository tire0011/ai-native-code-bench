// Generated by ai-native-code-bench local.ps1; safe to regenerate with that script.
// Template placeholders are replaced in the target project's .opencode/opencode.jsonc.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/csharp-local",
  "default_agent": "build",
  "instructions": [{{INSTRUCTIONS_PATH_JSON}}],
  "providers": {
    "ollama": {
      "models": {
        "csharp-local": {
          "name": {{DISPLAY_NAME_JSON}},
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": {{CONTEXT_TOKENS}},
            "output": 4096
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "ollama/csharp-local",
      "steps": 32,
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "title": { "model": "ollama/csharp-local" },
    "summary": { "model": "ollama/csharp-local" },
    "compaction": { "model": "ollama/csharp-local" },
    "general": { "model": "ollama/csharp-local" },
    "explore": { "model": "ollama/csharp-local" }
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 3000 },
    "buffer": "15%"
  },
  "tool_output": { "max_lines": 600, "max_bytes": 40000 },
  "mcp": {
    "servers": {
      "azure": {
        "type": "remote",
        "url": "http://127.0.0.1:5109/mcp",
        "disabled": true
      },
      "roslyn": {
        "type": "local",
        "command": ["dnx", "RoslynCodeLens.Mcp", "--yes"],
        "cwd": {{PROJECT_PATH_JSON}},
        "codemode": false,
        "timeout": {
          "startup": 120000,
          "catalog": 120000,
          "execution": 300000
        }
      }
    }
  },
  "permissions": [
    { "action": "roslyn_*", "resource": "*", "effect": "deny" },
    { "action": "roslyn_load_solution", "resource": "*", "effect": "allow" },
    { "action": "roslyn_list_solutions", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_task_status", "resource": "*", "effect": "allow" },
    { "action": "roslyn_go_to_definition", "resource": "*", "effect": "allow" },
    { "action": "roslyn_find_references", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_symbol_context", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_type_overview", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_method_source", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_file_overview", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_diagnostics", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_project_dependencies", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_nuget_dependencies", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_overloads", "resource": "*", "effect": "allow" },
    { "action": "roslyn_get_extension_methods", "resource": "*", "effect": "allow" },
    { "action": "roslyn_find_tests_for_symbol", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "dotnet workload *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" }
  ],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "ollama", "effect": "allow" }
  ]
}
